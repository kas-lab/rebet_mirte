define

## Attributes

### ROSNode attributes
package sub attribute,
    value string;
executable sub attribute,
    value string;
lifecycle_state sub attribute,
    value string,
    regex "^(unconfigured|inactive|active|finalized)$";
lifecycle_transition sub attribute,
    value string,
    regex "^(configure|shutdown|activate|deactivate|cleanup)$";

#### Should only be used by is_node_active rule
is_active sub attribute,
    value boolean;

### Runtime node attributes
node_name sub attribute,
    value string;
namespace sub attribute,
    value string;
start_time sub attribute,
    value datetime;
end_time sub attribute,
    value datetime;

### ROS interfaces attributes
interface_name sub attribute,
    value string;
interface_type sub attribute,
    value string;

gid sub attribute,
    value long;

### QoS attributes
reliability sub attribute,
    value string,
    regex "^(BEST_EFFORT|RELIABLE|SYSTEM_DEFAULT)";
history sub attribute,
    value string,
    regex "^(KEEP_LAST|KEEP_ALL|UNKNOWN|SYSTEM_DEFAULT)";
depth sub attribute,
    value long;
durability sub attribute,
    value string,
    regex "^(TRANSIENT_LOCAL|VOLATILE|SYSTEM_DEFAULT)";
deadline sub attribute,
    value long;  # 0 indicates infinite
lifespan sub attribute,
    value long;  # 0 indicates infinite
liveliness sub attribute,
    value string,
    regex "^(AUTOMATIC|MANUAL_BY_TOPIC|SYSTEM_DEFAULT)";
lease_duration sub attribute,
    value long;  # 0 indicates infinite

### Parameter attributes
parameter_name sub attribute,
    value string;

default_value sub attribute,
    value boolean;

## Entities

running sub attribute,
    value boolean;

ROSNode sub entity,
    owns node_name @key,
    owns namespace,
    owns start_time,
    owns end_time,
    owns running,
    plays has_interface:node,
    plays has_parameter:node,
    plays has_parameter_value:node,
    plays node_deployment:node,
    plays process_group:node,
    plays subnode:subnode;

LifeCycleNode sub ROSNode,
    owns lifecycle_state;

### ROS interfaces
ROSInterface sub entity,
    abstract,
    owns interface_name,
    owns interface_type,
    plays has_interface:afferent,
    plays has_interface:efferent;

TopicInterface sub ROSInterface,
    abstract,
    owns gid,
    plays has_qos:interface;
Subscriber sub TopicInterface,
    plays has_topic:subscriber;
Publisher sub TopicInterface,
    plays has_topic:publisher;

QoSProfile sub entity,
    owns reliability,
    owns history,
    owns depth,
    owns durability,
    owns deadline,
    owns lifespan,
    owns liveliness,
    owns lease_duration,
    plays has_qos:qos;

ServiceInterface sub ROSInterface,
    abstract;
ServiceClient sub ServiceInterface,
    plays has_service:client;
ServiceServer sub ServiceInterface,
    plays has_service:server;

ActionInterface sub ROSInterface,
    abstract;
ActionClient sub ActionInterface,
    plays has_action:client;
ActionServer sub ActionInterface,
    plays has_action:server;

has_qos sub relation,
    relates interface,
    relates qos;

has_interface sub relation,
    abstract,
    relates node,
    relates afferent,
    relates efferent;

has_topic sub has_interface,
    relates subscriber as afferent,
    relates publisher as efferent;

has_service sub has_interface,
    relates client as afferent,
    relates server as efferent;

has_action sub has_interface,
    relates client as afferent,
    relates server as efferent;

#### Connection to context model
Publisher plays measurement_interface:source;
Publisher plays measurement_interface:output;
ServiceServer plays measurement_interface:source;
ActionServer plays measurement_interface:source;

### Parameter related entities
Parameter sub entity,
    owns parameter_name,
    plays has_parameter:parameter,
    plays has_parameter_value:parameter;

ParameterBool sub Parameter;
ParameterInteger sub Parameter;
ParameterDouble sub Parameter;
ParameterString sub Parameter;

ParameterBoolArray sub Parameter;
ParameterIntegerArray sub Parameter;
ParameterStringArray sub Parameter;
ParameterDoubleArray sub Parameter;

Value plays has_parameter_value:parameter_value;

## Relations
has_parameter sub relation,
    relates node,
    relates parameter;

has_parameter_value sub relation,
    owns default_value,
    relates node,
    relates parameter,
    relates parameter_value;

node_deployment sub relation,
    owns package,
    owns executable,
    relates node;

process_group sub relation,
    relates node;

subnode sub process_group,
    relates subnode;


## rules
rule ros_node_not_running_has_end_time:
    when {
        $node isa ROSNode, has end_time $end_time;
    } then {
        $node has running false;
    };

rule ros_node_not_running_no_start_time:
    when {
        $node isa ROSNode;
        not {$node has start_time $start_time;};
    } then {
        $node has running false;
    };

rule ros_node_running:
    when {
        $node isa ROSNode;
        not {$node has running false;};
    } then {
        $node has running true;
    };
