name MaxSpeedInternal;
import "rebetmc.resolution";
import "test.context";
rule MIN {
 condition { 
  if(movement_power > 40.0) { 
   action { select_variant(rebetmc.LOW_SPEED)}} 
   effect {} 
  };
rule MED {
 condition {
  if(movement_power < 40.0 AND movement_power > 39.0) {
  	action { select_variant(rebetmc.MED_SPEED)}}
  	effect {} 
  };
rule MAX {
 condition {
  if(movement_power < 39.0)
  { 
   action { select_variant(rebetmc.HI_SPEED)}} 
   effect {} 
  };

