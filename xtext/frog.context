import "rebetmirte.rossystem";
ContextVariable nearest_object
{
	source: publisher: ref:ros_gz_bridge.scan
	cache? false
	function_name "get_nearest_laser_scan_ratio"
}
ContextVariable current_velocity
{
	source: publisher: ref:ros_gz_bridge.mirte_base_controller_slash_odom
	cache? false
	function_name "calc_linear_velocity"
}
ContextVariable power_draw
{
	source: publisher: ref:ros_gz_bridge.mirte_base_controller_slash_odom
	cache? true
	cache length 1s
	function_name "MovementPowerDraw"
}
ContextVariable power_budget
{
	source: service: ref: detect_object.detect_object_srv request_kwargs: ""
	cache? false
	proxy true
	function_name "PowerBudget"
}
